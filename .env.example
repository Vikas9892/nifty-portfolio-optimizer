# Copy this to .env and fill in your values.
# All variables have safe defaults for local development.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Nifty Portfolio Optimizer"
ENVIRONMENT=development          # set to "production" on Railway

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-real-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite:///data/portfolio.db
# PostgreSQL for production (Railway sets this automatically when you add the plugin):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave empty to run without Redis (cache + queue disabled gracefully):
REDIS_URL=
# Redis for production (Railway sets this automatically when you add the plugin):
# REDIS_URL=redis://default:password@host:6379

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (JSON array format):
# CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# ── Workers ───────────────────────────────────────────────────────────────────
WORKERS=1     # set to 2+ on Railway

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_OPTIMIZE=10/minute

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_FORMAT=text    # set to "json" in production for structured logs
