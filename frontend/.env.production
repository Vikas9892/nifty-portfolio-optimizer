# Production build config — loaded automatically by `vite build`
# (npm run build runs in production mode, so Vite reads this file).
#
# Committing this means the deployed API URL is baked into the bundle at build
# time and no Vercel dashboard environment variable is required.
#
# Note: this is a PUBLIC value. It ends up in the shipped JS bundle, so never
# put secrets in a VITE_* variable.

VITE_API_URL=https://nifty-optimizer-api.onrender.com
